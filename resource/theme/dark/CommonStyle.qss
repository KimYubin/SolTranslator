/* -------------------------------- */
/* QPushButton */
QPushButton
{
  outline: none;
  height: 32px;

  color: rgba(255, 255, 255, 0.95);
  font-weight: bold;
  font-size: 18px;

  margin: 0px;

  /* 바닥 패딩+테두리 = 3px*/
  padding: 2px 8px;
  border: 1px solid transparent;
}

QPushButton:hover 
{
  background-color: rgba(160, 160, 160, 0.44);
}
QPushButton:pressed
{
  background-color: rgba(117, 117, 117, 0.44);
}

QPushButton:focus
{
  border: 1px solid rgba(255, 255, 255, 0.84);
  border-radius: 2px;
}


/*unchecked*/
QPushButton[checkable="true"]
{
  padding-bottom: 2px;
  border-bottom: 1px solid transparent;
}
QPushButton[checkable="true"]:focus
{
  border-bottom: 1px solid rgba(255, 255, 255, 0.84);
}

/*checked*/
QPushButton:checked
{
  padding-bottom: 0px;
  border-bottom: 3px solid rgba(98, 187, 238, 1);
}
QPushButton:checked:focus
{
  border-bottom: 3px solid rgba(98, 187, 238, 1);
}


QPushButton:disabled {
  color: rgba(138, 138, 138, 0.51);
}

QPushButton:checked:disabled {
  color: rgba(138, 138, 138, 0.51);
  border-color:  #4f5b62;
}

 
/* QLineEdit */
QLineEdit
{
  border-radius: 0px;
}


/* QListView */
QListView
{
  background-color: rgba(35, 38, 41, 1);
  font-size: 16px;
  font-weight: 500;
  /* font-weight: bold; */
  border-radius: 0px;
  padding: 0px;
  margin: 0px;
  border: 0px;
  
}

QListView::item
{
  padding: 6px 4px;
  min-height: 32px;
  color: rgba(255, 255, 255, 0.9);
  selection-color: rgb(220, 222, 223);
  border-color: transparent;
}

QListView::item:hover
{
  color: rgba(0, 0, 0, 0.8);

  background-color:rgba(255, 255, 255, 0.80);
  selection-background-color:rgba(255, 255, 255, 0.80);
}


/* QMenu item*/
QMenu {
  background-color: rgba(37, 37, 37, 1);
  border: 1px solid rgba(100, 100, 100, 1);
  padding: 4px;
}

QComboBox::item,
QMenu::item
{
  height: 24px;
  border: 8px solid transparent;
  color: #ffffff;
  padding: 0px 8px 0px 8px;
  
}

QComboBox::item:selected,
QMenu::item:selected,
QListView::item:selected
{
  color: rgba(255, 255, 255, 1);
  selection-color: rgba(255, 255, 255, 1); /* For Windows */

  background-color:rgba(211, 211, 211, 0.29);
  selection-background-color:rgba(211, 211, 211, 0.29);
}

QComboBox::item:disabled,
QMenu::item:disabled 
{
  color: rgba(255, 255, 255, 0.3);
} 
QMenu::separator 
{
  height: 1px;
  background-color: rgba(90, 90, 90, 1);
}


/* QComboBox */
QComboBox
{
  color: rgba(255, 255, 255, 0.9);
  height: 32px;

  border: 2px solid rgba(255, 255, 255, 0.65);
  border-width: 0 0 2px 0;
  padding: 1px 8px;

  background-color: rgba(37, 37, 37, 1);
  background-color: rgba(35, 38, 41, 1);
}

QComboBox:disabled 
{
  color: rgba(255, 255, 255, 0.2);
  background-color: rgba(35, 38, 41, 0.3);
  border-bottom: 2px solid #232629;
}


QComboBox[frame='false'] 
{
  color: #ffffff;
  background-color: transparent;
  border: 1px solid transparent;
}

QComboBox[frame='false']:disabled 
{
  color: rgba(255, 255, 255, 0.2);
}

QComboBox::drop-down	
{
  
  color: #ffffff;
  width: 20px;
}




/*  ------------------------------------------------------------------------  */
/*  QToolTip  */

QToolTip QLabel
{
  font-size: 14px;
  padding: 4px;
  border: 1px solid rgba(50, 55, 60, 1);
  border-radius: 4px;
  color: #ffffff;
  background-color: #4f5b62;
}
QToolTip 
{
  font-size: 14px;
  padding: 4px;
  border: 1px solid rgba(50, 55, 60, 1);
  border-radius: 4px;
  color: #ffffff;
  background-color: #4f5b62;
  background-clip: content;

}

#FinToolTipBallon QLabel
{
  color: rgba(255, 255, 255, 0.9);;
  background-color: rgba(34, 34, 34, 1);

  border: 1px solid rgba(255, 255, 255, 0.27);
  border-radius: 4px;

  padding: 4px;
}