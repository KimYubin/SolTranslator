/* -------------------------------- */
/* QPushButton */
QPushButton
{
  outline: none;
  height: 32px;

  color: rgba(255, 255, 255, 0.9);
  font-weight: bold;
  font-size: 18px;

  margin: 0px;
  padding: 1px 16px;

  border: 1px solid transparent;
  border-bottom: 3px solid transparent;
}

QPushButton:hover 
{
  background-color: rgba(160, 160, 160, 0.44);
}

QPushButton:pressed
{
  background-color: rgba(117, 117, 117, 0.44);
}

QPushButton:checked
{
  border-bottom: 3px solid rgba(98, 187, 238, 1);
}
QPushButton:checked:focus
{
  padding: 1px 16px;
  
  border-bottom: 3px solid rgba(98, 187, 238, 1);
}
QPushButton:focus
{
  border: 1px solid rgba(255, 255, 255, 0.84);
  border-radius: 2px;
  padding-bottom: 3px;
}

QPushButton:disabled {
  color: rgba(138, 138, 138, 0.51);
}

QPushButton:checked:disabled {
  color: rgba(138, 138, 138, 0.51);
  border-color:  #4f5b62;
}

 
/* QLineEdit */
QLineEdit
{
  border-radius: 0px;
}


/* QListView */
QListView
{
  background-color: #232629;
  font-size: 16px;
  font-weight: 500;
  /* font-weight: bold; */
  border-radius: 0px;
  padding: 0px;
  margin: 0px;
  border: 0px;
  
}

QListView::item
{
  padding: 6px 4px;
  min-height: 32px;
  color: rgba(255, 255, 255, 0.9);
  selection-color: rgb(220, 222, 223);
  border-color: transparent;
}

QListView::item:hover
{
  color: rgba(0, 0, 0, 0.8);

  background-color:rgba(255, 255, 255, 0.80);
  selection-background-color:rgba(255, 255, 255, 0.80);
}


QComboBox::item:selected,
QMenu::item:selected,
QListView::item:selected
{
  color: rgba(255, 255, 255, 1);
  selection-color: rgba(255, 255, 255, 1); /* For Windows */

  background-color:rgba(211, 211, 211, 0.29);
  selection-background-color:rgba(211, 211, 211, 0.29);
}


QMenu {
  background-color: rgba(37, 37, 37, 1);
  border: 1px solid rgba(100, 100, 100, 1);
}

QComboBox::item,
QMenu::item
{
  height: 24px;
  border: 8px solid transparent;
  color: #ffffff;
  padding: 0px 24px 0px 8px;
}
QComboBox::item:disabled,
QMenu::item:disabled 
{
  color: rgba(255, 255, 255, 0.3);
} 
QMenu::separator 
{
  height: 2px;
  background-color: rgba(90, 90, 90, 1);
  margin-left: 2px;
  margin-right: 2px;
}