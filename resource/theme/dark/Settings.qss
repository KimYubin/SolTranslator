}

/*  ------------------------------------------------------------------------  */
/*  QCheckBox and QGroupBox Indicator  */

#SettingsWidget QCheckBox::indicator:checked,
#SettingsWidget QGroupBox::indicator:checked {
  /* image: url(icon:/primary/checkbox_checked.svg); */
}

#SettingsWidget QCheckBox::indicator:unchecked,
#SettingsWidget QGroupBox::indicator:unchecked {
