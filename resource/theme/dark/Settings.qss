}

#SettingsWidget QCheckBox::indicator:checked:disabled,
#SettingsWidget QGroupBox::indicator:checked:disabled {
  /* image: url(icon:/disabled/checkbox_checked.svg); */
}

#SettingsWidget QCheckBox::indicator:unchecked:disabled,
#SettingsWidget QGroupBox::indicator:unchecked:disabled {
  /* image: url(icon:/disabled/checkbox_unchecked.svg); */
}

#SettingsWidget QCheckBox::indicator:indeterminate:disabled,
#SettingsWidget QGroupBox::indicator:indeterminate:disabled {
