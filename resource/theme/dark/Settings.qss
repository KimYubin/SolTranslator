#SettingsWidget
{
  background-color: #31363b;
}

/* #SettingsWidget QGroupBox, */
#SettingsWidget QFrame
{
  background-color: #31363b;
}
#SettingsWidget QListWidget
{
  background-color: #232629;
}

#SettingsWidget QLineEdit
{
  border-radius: 0px;
}

#SettingsWidget QListView
{
  font-size: 16px;
  border-radius: 0px;
  padding: 0px;
  margin: 0px;
  border: 0px;
}
#SettingsWidget QListView::item
{
  padding: 4px;
  min-height: 32px;
  color:rgb(219, 219, 219);
  selection-color: rgb(219, 219, 219);
  border-color: transparent;
}

#SettingsWidget QListView::item:hover
{
  background-color:rgba(214, 214, 214, 0.88);
  selection-background-color:rgba(214, 214, 214, 0.88);
  color: #000000;
}

#SettingsWidget QListView::item:selected 
{
  background-color:rgba(211, 211, 211, 0.29);
  selection-background-color:rgba(211, 211, 211, 0.29);
  color: rgb(219, 219, 219);
  selection-color: rgb(219, 219, 219); /* For Windows */
}

#SettingsWidget QSplitter
{
  background-color: transparent;
  border: none
}

#SettingsWidget QStatusBar
{
  color: #ffffff;
  background-color: rgba(79, 91, 98, 0.2);
  border-radius: 0px;
}

#SettingsWidget QScrollArea,
#SettingsWidget QStackedWidget,
#SettingsWidget QWidget > QToolBox,
#SettingsWidget QToolBox > QWidget,
#SettingsWidget QTabWidget > QWidget
{
  border: none;
}

#SettingsWidget QTabWidget::pane
{
  border: none;
}

#SettingsWidget QLabel
{
  border: none;
  background: transparent;
  color: #ffffff
}
#SettingsWidget  QLabel:disabled
{
  color: rgba(255, 255, 255, 0.2)
}


#SettingsWidget  QLineEdit
{
  color: #ffffff;
  padding-left: 8px;
  height: 32px;
  background-color: rgba(35, 38, 41, 0.75);
  border-width: 0 0 2px 0;
}

#SettingsWidget QGroupBox
{
  font-size: 16px;
  border: none;
  padding-top: 24px;
  margin-top: 0.5em;
  
}

#SettingsWidget QGroupBox::title
{
  color: rgba(255, 255, 255, 0.67);
  subcontrol-origin: margin;
}

#SettingsWidget QPushButton[selectButton="true"]
{
  border: none;
  background-color:rgb(68, 93, 116);
  color:rgb(240, 240, 232)
}


#SettingsWidget QPushButton {
  margin: 0px;
  padding: 1px 16px;
  height: 32px;
  font-weight: bold;
  border-radius: 4px;
  background-color:#6fc5ff;
}

#SettingsWidget QPushButton:flat {
  margin: 0px;
  color: #6fc5ff;
  border: none;
  background-color: transparent;
}

#SettingsWidget QPushButton:checked,
#SettingsWidget QPushButton:pressed {
  color: #31363b;
  background-color:#6fc5ff;
}


#SettingsWidget QPushButton:flat:hover {
  background-color:rgb(179, 225, 255);
}
#SettingsWidget QPushButton:flat:pressed,
#SettingsWidget QPushButton:flat:checked {
  background-color: rgb(179, 225, 255);
}
#SettingsWidget QPushButton:flat:disabled {
  color: rgb(49, 51, 53);
  background-color: rgb(84, 99, 107);
  border: none;
}

#SettingsWidget QPushButton:disabled {
  border: 2px solid rgb(49, 51, 53);
}

#SettingsWidget QPushButton:disabled {
  color: rgba(79, 91, 98, 0.75);
  border-color:  #4f5b62;
}

#SettingsWidget QPushButton:checked:disabled {
  color: #232629;
  background-color: #4f5b62;
  border-color:  #4f5b62;
}

#SettingsWidget QToolButton:focus,
#SettingsWidget QPushButton:focus {
  background-color: rgba(29, 233, 182, 0.2);
}

#SettingsWidget QPushButton:checked:focus,
#SettingsWidget QPushButton:pressed:focus {
  background-color: rgba(29, 233, 182, 0.8);
}

#SettingsWidget QPushButton:flat:focus {
  border: none;
  background-color: rgba(29, 233, 182, 0.2);
}

#SettingsWidget QPushButton 
{
  background-color: rgb(179, 225, 255);
  border: 2px solid rgb(179, 225, 255);
  border-radius: 4px;
  height: 32px;
}
