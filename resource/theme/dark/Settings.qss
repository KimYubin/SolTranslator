/*  ------------------------------------------------------------------------  */
/* QtMaterial - https://github.com/UN-GCPDS/qt-material
/* By Yeison Cardona - GCPDS
/*  ------------------------------------------------------------------------  */
#SettingsWidget
*{
  color: #111111;

  font-family: 'Noto Sans KR', 'Cascadia Mono', Consolas, monospace;



  font-size: 13px;



  line-height: 13px;


  selection-background-color: #6effe8;
  selection-color: #000000;
}


#SettingsWidget
*:focus {
   outline: none;
}

/*  ------------------------------------------------------------------------  */
/*  Custom colors  */

#SettingsWidget
.danger{
  color: #dc3545;
  background-color: transparent;
}

#SettingsWidget
.warning{
  color: #ffc107;
  background-color: transparent;
}

#SettingsWidget
.success{
  color: #17a2b8;
  background-color: transparent;
}

#SettingsWidget
.danger:disabled{
  color: rgba(220, 53, 69, 0.4);
  border-color: rgba(220, 53, 69, 0.4);
}

#SettingsWidget
.warning:disabled{
  color: rgba(255, 193, 7, 0.4);
  border-color: rgba(255, 193, 7, 0.4);
}

#SettingsWidget
.success:disabled{
  color: rgba(23, 162, 184, 0.4);
  border-color: rgba(23, 162, 184, 0.4);
}

#SettingsWidget
.danger:flat:disabled{
  background-color: rgba(220, 53, 69, 0.1);
}

#SettingsWidget
.warning:flat:disabled{
  background-color: rgba(255, 193, 7, 0.1);
}

#SettingsWidget
.success:flat:disabled{
  background-color: rgba(23, 162, 184, 0.1);
}

/*  ------------------------------------------------------------------------  */
/*  Basic widgets  */

#SettingsWidget
{
  background-color: #31363b;
}

#SettingsWidget QGroupBox,
#SettingsWidget QFrame {
  background-color: #31363b;
  border: 2px solid #4f5b62;
  border-radius: 4px;
}

#SettingsWidget QGroupBox.fill_background,
#SettingsWidget QFrame.fill_background {
  background-color: #232629;
  border: 2px solid #232629;
  border-radius: 4px;
}

#SettingsWidget QSplitter {
  background-color: transparent;
  border: none
}

#SettingsWidget QStatusBar {
  color: #ffffff;
  background-color: rgba(79, 91, 98, 0.2);
  border-radius: 0px;
}

#SettingsWidget QScrollArea,
#SettingsWidget QStackedWidget,
#SettingsWidget QWidget > QToolBox,
#SettingsWidget QToolBox > QWidget,
#SettingsWidget QTabWidget > QWidget {
  border: none;
}

#SettingsWidget QTabWidget::pane {
  border: none;
}

/*  ------------------------------------------------------------------------  */
/*  Inputs  */

#SettingsWidget QDateTimeEdit,
#SettingsWidget QSpinBox,
#SettingsWidget QDoubleSpinBox,
#SettingsWidget QTextEdit,
#SettingsWidget QLineEdit,
#SettingsWidget QPushButton {
  color: #1de9b6;
  background-color: #31363b;
  border: 2px solid #1de9b6;
  border-radius: 4px;
  height: 32px;
}

#SettingsWidget QDateTimeEdit,
#SettingsWidget QSpinBox,
#SettingsWidget QDoubleSpinBox,
#SettingsWidget QTreeView,
#SettingsWidget QListView,
#SettingsWidget QLineEdit,
#SettingsWidget QComboBox {
  color: #000000;
  padding-left: 16px;
  border-radius: 0px;
  border-radius: 0px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  height: 32px;
  background-color: rgba(35, 38, 41, 0.75);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-width: 0 0 2px 0;
}

#SettingsWidget QPlainTextEdit {
  border-radius: 4px;
  padding: 8px 16px;
  background-color: #31363b;
  border: 2px solid #4f5b62;
}

#SettingsWidget QTextEdit {
  padding: 8px 16px;
  border-radius: 4px;
  background-color: #232629;
}

#SettingsWidget QDateTimeEdit:disabled,
#SettingsWidget QSpinBox:disabled,
#SettingsWidget QDoubleSpinBox:disabled,
#SettingsWidget QTextEdit:disabled,
#SettingsWidget QLineEdit:disabled {
  color: rgba(255, 255, 255, 0.2);
  background-color: rgba(35, 38, 41, 0.3);
  border: 2px solid #232629;
  border-width: 0 0 2px 0;
  padding: 0px 16px;
  border-radius: 0px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  height: 32px;
}

/*  ------------------------------------------------------------------------  */
/*  QComboBox  */

#SettingsWidget QComboBox {
  color: #000000;
  border: 2px solid #1de9b6;
  border-radius: 0px;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  height: 32px;
  background-color: rgba(35, 38, 41, 0.75);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-width: 0 0 2px 0;
}

#SettingsWidget QComboBox:disabled {
  color: rgba(255, 255, 255, 0.2);
  background-color: rgba(35, 38, 41, 0.3);
  border-bottom: 2px solid #232629;
}

#SettingsWidget QComboBox::drop-down {
  border: none;
  color: #1de9b6;
  width: 20px;
}

#SettingsWidget QComboBox::down-arrow {
  /* image: url(icon:/active/downarrow.svg); */
  margin-right: 12px;
}

#SettingsWidget QComboBox::down-arrow:focus {
  /* image: url(icon:/primary/downarrow.svg); */
  margin-right: 12px;
}

#SettingsWidget QComboBox::down-arrow:disabled {
  /* image: url(icon:/disabled/downarrow.svg); */
  margin-right: 12px;
}

#SettingsWidget QComboBox QAbstractItemView {
  background-color: #232629;
  border: 2px solid #4f5b62;
  border-radius: 4px;
}

#SettingsWidget QComboBox[frame='false'] {
  color: #ffffff;
  background-color: transparent;
  border: 1px solid transparent;
}

#SettingsWidget QComboBox[frame='false']:disabled {
  color: rgba(255, 255, 255, 0.2);
}

/*  ------------------------------------------------------------------------  */
/*  Spin buttons  */

#SettingsWidget QDateTimeEdit::up-button,
#SettingsWidget QDoubleSpinBox::up-button,
#SettingsWidget QSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 20px;
  /* image: url(icon:/active/uparrow.svg); */
  border-width: 0px;
  margin-right: 5px;
}

#SettingsWidget QDateTimeEdit::up-button:disabled,
#SettingsWidget QDoubleSpinBox::up-button:disabled,
#SettingsWidget QSpinBox::up-button:disabled {
  /* image: url(icon:/disabled/uparrow.svg); */
}

#SettingsWidget QDateTimeEdit::down-button,
#SettingsWidget QDoubleSpinBox::down-button,
#SettingsWidget QSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 20px;
  /* image: url(icon:/active/downarrow.svg); */
  border-width: 0px;
  border-top-width: 0;
  margin-right: 5px;
}

#SettingsWidget QDateTimeEdit::down-button:disabled,
#SettingsWidget QDoubleSpinBox::down-button:disabled,
#SettingsWidget QSpinBox::down-button:disabled {
  /* image: url(icon:/disabled/downarrow.svg); */
}

/*  ------------------------------------------------------------------------  */
/*  QPushButton  */

#SettingsWidget QPushButton {
  text-transform: uppercase;
  margin: 0px;
  padding: 1px 16px;
  height: 32px;
  font-weight: bold;

  
    border-radius: 4px;
  
}

#SettingsWidget QPushButton:checked,
#SettingsWidget QPushButton:pressed {
  color: #31363b;
  background-color: #1de9b6;
}

#SettingsWidget QPushButton:flat {
  margin: 0px;
  color: #1de9b6;
  border: none;
  background-color: transparent;
}

#SettingsWidget QPushButton:flat:hover {
  background-color: rgba(29, 233, 182, 0.1);
}

#SettingsWidget QPushButton:flat:pressed,
#SettingsWidget QPushButton:flat:checked {
  background-color: rgba(29, 233, 182, 0.1);
}

#SettingsWidget QPushButton:disabled {
  color: rgba(79, 91, 98, 0.75);
  background-color: transparent;
  border-color:  #4f5b62;
}

#SettingsWidget QPushButton:flat:disabled {
  color: rgba(79, 91, 98, 0.75);
  background-color: rgba(79, 91, 98, 0.25);
  border: none;
}

#SettingsWidget QPushButton:disabled {
  border: 2px solid rgba(79, 91, 98, 0.75);
}

#SettingsWidget QPushButton:checked:disabled {
  color: #232629;
  background-color: #4f5b62;
  border-color:  #4f5b62;
}

#SettingsWidget QToolButton:focus,
#SettingsWidget QPushButton:focus {
  background-color: rgba(29, 233, 182, 0.2);
}

#SettingsWidget QPushButton:checked:focus,
#SettingsWidget QPushButton:pressed:focus {
  background-color: rgba(29, 233, 182, 0.8);
}

#SettingsWidget QPushButton:flat:focus {
  border: none;
  background-color: rgba(29, 233, 182, 0.2);
}

/*  ------------------------------------------------------------------------  */
/*  QTabBar  */


/*  ------------------------------------------------------------------------  */
/*  QGroupBox  */

#SettingsWidget QGroupBox {
  padding: 16px;
  padding-top: 36px;
  line-height: ;
  text-transform: uppercase;
  font-size: ;
}

#SettingsWidget QGroupBox::title {
  color: rgba(255, 255, 255, 0.4);
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 16px;
  background-color: #31363b;
  background-color: transparent;
  height: 36px;
}

/*  ------------------------------------------------------------------------  */
/*  QRadioButton and QCheckBox labels  */

#SettingsWidget QRadioButton,
#SettingsWidget QCheckBox {
  spacing: 12px;
  color: #ffffff;
  line-height: 14px;
  height: 36px;
  background-color: transparent;
  spacing: 5px;
}

#SettingsWidget QRadioButton:disabled,
#SettingsWidget QCheckBox:disabled {
  color: rgba(255, 255, 255, 0.3);
}

/*  ------------------------------------------------------------------------  */
/*  General Indicators  */

#SettingsWidget QGroupBox::indicator {
  width: 24px;
  height: 24px;
  border-radius: 3px;
}

#SettingsWidget QMenu::indicator,
#SettingsWidget QListView::indicator,
#SettingsWidget QTableWidget::indicator,
#SettingsWidget QRadioButton::indicator,
#SettingsWidget QCheckBox::indicator {
  width: 28px;
  height: 28px;
  border-radius: 4px;
 }
 
