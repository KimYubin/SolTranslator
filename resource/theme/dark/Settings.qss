/*  ------------------------------------------------------------------------  */
/*  QRadioButton Indicator  */

#SettingsWidget QRadioButton::indicator:checked {
  /* image: url(icon:/primary/radiobutton_checked.svg); */
}

#SettingsWidget QRadioButton::indicator:unchecked {
  /* image: url(icon:/primary/radiobutton_unchecked.svg); */
}

#SettingsWidget QRadioButton::indicator:checked:disabled {
  /* image: url(icon:/disabled/radiobutton_checked.svg); */
}

#SettingsWidget QRadioButton::indicator:unchecked:disabled {
